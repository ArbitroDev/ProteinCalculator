  "fixed_sql": [
    {
      "name": "entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"entries\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NULL, \"name_key\" TEXT NULL, \"mode\" TEXT NOT NULL, \"protein_grams\" REAL NOT NULL, \"consumed_grams\" REAL NULL, \"protein_per_reference\" REAL NULL, \"reference_grams\" REAL NULL, \"created_at\" INTEGER NOT NULL, \"day_key\" INTEGER NOT NULL, \"slot\" TEXT NOT NULL DEFAULT 'morning');"
        }
      ]
    },
    {
      "name": "products",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"products\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"name_key\" TEXT NOT NULL UNIQUE, \"mode\" TEXT NOT NULL, \"protein_grams\" REAL NULL, \"consumed_grams\" REAL NULL, \"protein_per_reference\" REAL NULL, \"reference_grams\" REAL NULL, \"use_count\" INTEGER NOT NULL DEFAULT 0, \"last_used_at\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, \"is_favorite\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_favorite\" IN (0, 1)), \"routine\" TEXT NOT NULL DEFAULT 'none', \"routine_minutes\" INTEGER NULL, \"routine_checked_at\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"id\" INTEGER NOT NULL, \"daily_goal_grams\" REAL NULL, \"product_sort\" TEXT NOT NULL DEFAULT 'alphabetical', \"day_start_hour\" INTEGER NOT NULL DEFAULT 3, \"history_view\" TEXT NOT NULL DEFAULT 'list', \"crash_reports\" INTEGER NOT NULL DEFAULT 0 CHECK (\"crash_reports\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "goal_changes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"goal_changes\" (\"day_key\" INTEGER NOT NULL, \"grams\" REAL NOT NULL, PRIMARY KEY (\"day_key\"));"
        }
      ]
    },
