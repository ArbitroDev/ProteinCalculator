<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown until Compose draws: the background of the app. -->
    <style name="Theme.ProteinCalculator" parent="@android:style/Theme.DeviceDefault">
        <item name="android:windowBackground">@color/background</item>
    </style>

    <!-- Launch of the app: its icon on a black background, as Wear OS asks. -->
    <style name="Theme.ProteinCalculator.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.ProteinCalculator</item>
    </style>
</resources>
